{
  "compatibility_date": "2025-04-01",
  "name": "flaredrive",
  "main": "./index.js",
  "keep_vars": true,
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "ReindexerDO",
        "name": "REINDEXER_DO"
      }
    ]
  },
  "images": {
    "binding": "IMAGES"
  }
}