{
  "compatibility_date": "2025-04-01",
  "name": "flaredrive",
  "main": "./dist_worker/index.js",
  "keep_vars": true,
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "env": {
    "dev": {
      "vars": {},
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "bucket"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "KV",
          "id": "kv"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "flaredrive",
          "database_id": "db"
        }
      ]
    }
  }
}